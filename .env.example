# Copiez ce fichier vers .env. Ne mettez jamais .env dans Git.
# NODE_ENV=production  # استعملها فقط على خادم production مع HTTPS
HOST=127.0.0.1
PORT=3001
PUBLIC_ORIGIN=http://127.0.0.1:3001
DATA_DIR=data

# Base actuelle. SQLite ne demande ni serveur ni mot de passe.
DB_DRIVER=sqlite
# Réservé à un futur adaptateur PostgreSQL / Supabase :
DATABASE_URL=

# APIs optionnelles à brancher plus tard côté serveur uniquement.
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_PUBLISHABLE_KEY=

# Seulement lors du tout premier démarrage (12 caractères minimum).
ADMIN_PASSWORD=
